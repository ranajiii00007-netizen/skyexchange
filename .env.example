# Copy this file to a file named env next to main.exe.
# Use the same DATABASE_URL on every PC.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Optional one-time migration source for local SQLite data.
# Example: SQLITE_DB_PATH=newdata.db
# SQLITE_DB_PATH=exchange.db

# Optional developer-only setting. Do not enable this on shared office PCs.
# ALLOW_SQLITE_FALLBACK=1
